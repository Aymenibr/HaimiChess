{
  "manifest_version": 3,
  "name": "Chess Game Submitter",
  "version": "1.0",
  "description": "Fetch and submit your latest Chess.com games for analysis instantly.",
  "action": {
    "default_popup": "index.html",
    "default_icon": "icon.png"
  },
  "permissions": [
    "storage"
  ],
  "host_permissions": [
    "https://api.chess.com/*",
    "https://analysis-chess.io.vn/*"
  ],
  "icons": {
    "16": "icon.png",
    "48": "icon.png",
    "128": "icon.png"
  }
}
